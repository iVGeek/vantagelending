---
import Base from '../../layouts/Base.astro';
import ClientPage from '../../components/ClientPage.astro';
import { GUIDES } from '../../data/client-site.mjs';

export function getStaticPaths() {
  return GUIDES.map(({ slug, title }) => ({ params: { slug }, props: { title } }));
}

const { slug } = Astro.params;
const { title } = Astro.props;
---

<Base title={`${title} | SME Lending Platform`} description="Plain-English guide to business and property finance.">
  <ClientPage page="guide" slug={slug} />
</Base>
