---
import Base from '../../../layouts/Base.astro';
import GlossaryList from '../../../components/GlossaryList.astro';
import { glossary } from '../../../data/resources.mjs';
---

<Base
  title="Glossary | SME Lending Platform"
  description="Every lender term you will meet, translated into plain English — {glossary.length} entries and counting."
>
  <section class="hero" style="padding-bottom:1rem;">
    <div class="container" style="max-width:820px;">
      <span class="eyebrow">Learn · Glossary</span>
      <h1>The jargon, translated</h1>
      <p class="sub">Lenders hide nothing in the small print — they hide it in the vocabulary. {glossary.length} terms, each in one breath.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container" style="max-width:820px;">
      <GlossaryList />
      <div style="margin-top:1.6rem;">
        <a class="btn btn-primary" href="/faqs/">Read the FAQs</a>{' '}
        <a class="btn btn-ghost" href="/learn/">Browse the guides</a>
      </div>
    </div>
  </section>
</Base>