---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site.mjs';
---

<Base
  title="About | Vantage Lending"
  description="Vantage Lending is a direct lender built around published prices, named underwriters and property and business finance without the fine print."
>
  <section class="hero" style="padding-bottom:1rem;">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>A lender that prices like a retailer</h1>
      <p class="sub">{site.tagline} We publish the price list, put a named underwriter on your case and charge nothing to come and go.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container">
      <div class="stat-band">
        {site.stats.map((s) => (
          <div><b>{s.value}</b><span>{s.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:1rem;">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">What we’re for</span>
        <h2>Property finance and business finance need different honesty</h2>
      </div>
      <p style="color:var(--muted);">
        Property bridging runs best with one person who knows the file from bid to completion. Business finance runs best
        when the cost is agreed in writing before a single document is requested.
      </p>
      <ul class="tick-list">
        <li>Rates published and honoured — what the page says is what the offer says.</li>
        <li>A named underwriter from enquiry through to completion.</li>
        <li>No exit fees, no ERC and no application charges on business facilities.</li>
        <li>Decisions in days: business finance funds in 24–48 hours on quick decisions.</li>
      </ul>
      <div style="margin-top:1.6rem;">
        <a class="btn btn-primary" href="/products/">See the products</a> {''}
        <a class="btn btn-ghost" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</Base>