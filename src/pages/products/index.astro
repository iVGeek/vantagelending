---
import Base from '../../layouts/Base.astro';
import ProductShop from '../../components/ProductShop.astro';
import { products } from '../../data/products.mjs';
---

<Base
  title="All Products | Vantage Lending"
  description="Every Vantage Lending product on one page — business loans, revenue-based finance, bridging, development and bridge-to-let with published rates."
>
  <section class="hero" style="padding-bottom:1.5rem;">
    <div class="container">
      <span class="eyebrow">Products</span>
      <h1>All the products, on one page</h1>
      <p class="sub">Rates, ranges and terms up front. Pick the product that matches the problem — or apply and an underwriter will route you.</p>
    </div>
  </section>

  <section class="section-tight section">
    <div class="container">
      <div class="grid-products">
        {products.map((p) => <ProductShop product={p} />)}
      </div>
    </div>
  </section>
</Base>