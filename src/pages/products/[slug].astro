---
import Base from '../../layouts/Base.astro';
import ClientPage from '../../components/ClientPage.astro';
import { PRODUCT_ROUTES, PRODUCTS } from '../../data/client-site.mjs';

export function getStaticPaths() {
  return PRODUCT_ROUTES.map(({ slug, id }) => ({ params: { slug }, props: { id } }));
}

const { id } = Astro.props;
const product = PRODUCTS.find((p) => p.id === id);
---

<Base title={`${product?.name || 'Product'} | SME Lending Platform`} description={product?.sum}>
  <ClientPage page="product" slug={id} />
</Base>
