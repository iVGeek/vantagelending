---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import { invest } from '../../../data/invest.mjs';
import { investFaqs } from '../../../data/deals.mjs';
import { site } from '../../../data/site.mjs';
---

<Base
  title="How Investing Works | SME Lending Platform"
  description="Plain-English: how lending capital meets SME and property deals, how repayment happens, and what the eligibility gate is for."
>
  <section class="hero" style="padding-bottom:1rem;">
    <div class="container">
      <span class="eyebrow">Invest · How it works</span>
      <h1>How lending capital meets SME deals</h1>
      <p class="sub">The same mechanics that make SME lending predictable for borrowers make it readable for investors — if the numbers are shown honestly. Here is the plain-English version.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">The model</span>
        <h2>Deal by deal, not a blind fund</h2>
      </div>
      {invest.howItWorks.map((s) => (
        <div style="margin-bottom:1.4rem;">
          <b style="color:var(--accent-strong);">Step {s.n} — {s.title}</b>
          <p style="color:var(--muted); margin:.3rem 0 0;">{s.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border); padding-top:2rem;">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">Repayment</span>
        <h2>How returns come back</h2>
      </div>
      <ul class="tick-list">
        <li><b>Bridging and development</b> pay monthly or at maturity, secured by first charge, serviced by the borrower or funded by the exit.</li>
        <li><b>Revenue-based facilities</b> repay as a percentage of the borrower’s card sales — exposure is unsecured but repayments track live revenue.</li>
        <li><b>Every deal</b> shows security, LTV, term and an indicative target return before you register — returns are projections, not promises.</li>
      </ul>
      <p class="note" style="margin-top:1rem;">The platforms’ fees and any custodial arrangement will be stated per deal once finalised — currently pre-launch and subject to solicitor sign-off.</p>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border); padding-top:2rem;">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">The gate</span>
        <h2>Why you must self-certify first</h2>
      </div>
      <p style="color:var(--muted);">
        Without FCA authorisation, promoting investment opportunities to the public is a restricted activity. So actual deal
        terms and return figures sit behind a self-certification gate for high-net-worth, sophisticated or institutional
        investors — and this whole structure needs solicitor sign-off before launch. The gate is the honest version of that.
      </p>
      <div style="margin-top:1.4rem;">
        <a class="btn btn-primary" href="/invest/deals/">Go through the gate to the deals</a>{' '}
        <a class="btn btn-ghost" href="/invest/eligibility/">See the definitions</a>
      </div>
      <p class="disclosure" style="margin-top:1rem;">{site.investNote}</p>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border); padding-top:2rem;">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">FAQs</span>
        <h2>Investor questions</h2>
      </div>
      <Faq items={investFaqs} />
    </div>
  </section>
</Base>