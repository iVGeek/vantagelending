---
import Base from '../../layouts/Base.astro';
import { invest } from '../../data/invest.mjs';
import { site } from '../../data/site.mjs';
---

<Base
  title="Invest | SME Lending Platform"
  description="Invest in SME lending and property bridging — deal by deal, for high net worth, sophisticated and institutional investors."
>
  <section class="hero" style="padding-bottom:1rem;">
    <div class="container">
      <span class="eyebrow">Invest</span>
      <h1>Invest in business and property lending</h1>
      <p class="sub">
        Capital from eligible investors funds the deals on this platform, with security, term and funding progress shown for
        each one. Returns are illustrative; access is restricted to eligible investors.
      </p>
      <div>
        <a class="btn btn-primary" href="/invest/how-it-works/">How investing works</a>{' '}
        <a class="btn btn-ghost" href="/invest/deals/">See the live deals</a>{' '}
        <a class="btn btn-ghost" href="/invest/calculator/">Return calculator</a>
      </div>
      <p class="disclosure" style="margin:1.2rem 0 0;">{site.investNote}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>Four-step application process</h2>
      </div>
      <div class="stat-band steps-4" style="border:0; padding:0; gap:1rem; grid-template-columns:repeat(4,1fr);">
        {invest.howItWorks.map((s) => (
          <div class="card" style="padding:1.1rem;">
            <b style="color:var(--accent-strong); display:block;">Step {s.n}</b>
            <h3 style="font-size:1rem; margin:.3rem 0;">{s.title}</h3>
            <p style="color:var(--muted); font-size:.92rem; margin:0;">{s.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border); padding-top:2rem;">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who it’s for</span>
        <h2>Three ways to qualify</h2>
        <p>Promotion of investment opportunities is restricted while we are unregulated, so you must be one of these before seeing deal terms or return figures.</p>
      </div>
      <div class="grid-articles" style="grid-template-columns:repeat(3,1fr);">
        {invest.categories.map((c) => (
          <div class="card">
            <span class="eyebrow">{c.name}</span>
            <h3 style="margin:.5rem 0;">{c.name}</h3>
            <p style="color:var(--muted); font-size:.95rem;">{c.def}</p>
            {c.tags.map((t) => <p style="margin:.3rem 0 0; font-size:.82rem;">✓ {t}</p>)}
          </div>
        ))}
      </div>
      <div style="margin-top:1.6rem;">
        <a class="btn btn-dark" href="/invest/eligibility/">Check which applies to you</a>{' '}
        <a class="btn btn-ghost" href="/invest/register/">Register interest</a>
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border); padding-top:2rem;">
    <div class="container" style="max-width:820px;">
      <div class="card" style="border-left:4px solid var(--incorrect);">
        <h3 style="margin-top:0;">What this is not</h3>
        <ul class="tick-list" style="margin:0 0 0.4rem;">
          <li>Not a live investment or checkout — this site captures interest only.</li>
          <li>Not authorised to hold client money — there is nothing to pay here.</li>
          <li>Not advice, and not a guarantee — capital is at risk.</li>
        </ul>
        <div style="margin-top:1rem;">
          <a class="btn btn-primary" href="/invest/institutional/">Institutional &amp; family office</a>{' '}
          <a class="btn btn-ghost" href="/legal/">Risk warnings in full</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .steps-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 860px) {
    .steps-4 {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>