---
import Base from '../../../layouts/Base.astro';
import { invest } from '../../../data/invest.mjs';
import { site } from '../../../data/site.mjs';
---

<Base
  title="Investor Eligibility | SME Lending Platform"
  description="Self certify as high net worth, sophisticated or institutional — the categories translated into plain English."
>
  <section class="hero" style="padding-bottom:1rem;">
    <div class="container" style="max-width:820px;">
      <span class="eyebrow">Invest · Eligibility</span>
      <h1>Which investor are you?</h1>
      <p class="sub">
        Three categories, translated. Tick the one that applies when you go through the gate — the exact definitions
        and wording need solicitor sign off before launch.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container" style="max-width:820px;">
      {invest.categories.map((c) => (
        <div class="card" style="margin-bottom:1.2rem;">
          <span class="eyebrow">{c.name}</span>
          <h3 style="margin:.4rem 0 .4rem;">{c.name}</h3>
          <p style="color:var(--muted); margin:0;">{c.def}</p>
          {c.tags.map((t) => <p style="margin:.5rem 0 0; font-size:.9rem;">✓ {t}</p>)}
        </div>
      ))}
      <div class="card" style="border-left:4px solid var(--incorrect);">
        <h3 style="margin-top:0;">If none of these apply</h3>
        <p style="color:var(--muted); margin:0;">
          You cannot see deal terms or return figures on this platform while it is unregulated — that is the law, and we will
          not work around it. If the route opens up under authorised promotion, the site will say so plainly here.
        </p>
      </div>
      <div style="margin-top:1.6rem;">
        <a class="btn btn-primary" href="/invest/register/">Register interest</a>{' '}
        <a class="btn btn-ghost" href="/invest/">Back to the invest overview</a>
      </div>
      <p class="disclosure" style="margin-top:1.4rem;">{site.investNote}</p>
    </div>
  </section>
</Base>