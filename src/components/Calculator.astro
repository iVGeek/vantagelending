---
const { compact = false } = Astro.props;
---

<div id="shop-calc" class="card calc" style={compact ? 'padding:1.3rem;' : 'padding:1.6rem;'}>
  <div class="calc-head">
    <h2>Cost calculator</h2>
    <p>Indicative figures only. Nothing is stored or committed.</p>
  </div>

  <div class="tabs" role="tablist">
    <button class="tab active" type="button" data-mode="bridging" role="tab">Bridging</button>
    <button class="tab" type="button" data-mode="business" role="tab">Business</button>
  </div>

  <div data-fields="bridging">
    <div class="form-grid">
      <div class="form-field">
        <label>Amount <b id="b-amount-out" style="color:var(--accent-strong);">£300,000</b></label>
        <input id="b-amount" type="range" min="50000" max="5000000" step="50000" value="300000" style="width:100%;" />
      </div>
      <div class="form-field">
        <label>Loan to value <b id="b-ltv-out" style="color:var(--accent-strong);">55%</b></label>
        <input id="b-ltv" type="range" min="20" max="75" step="1" value="55" style="width:100%;" />
      </div>
      <div class="form-field">
        <label>Term <b id="b-term-out" style="color:var(--accent-strong);">12 months</b></label>
        <input id="b-term" type="range" min="1" max="24" step="1" value="12" style="width:100%;" />
      </div>
    </div>
    <p class="calc-rate">Rate: <b id="out-rate" style="color:var(--ink);">0.64%</b> per month <span id="out-band"></span></p>
  </div>

  <div data-fields="business" hidden>
    <div class="form-grid">
      <div class="form-field">
        <label>Amount <b id="s-amount-out" style="color:var(--accent-strong);">£100,000</b></label>
        <input id="s-amount" type="range" min="10000" max="1000000" step="10000" value="100000" style="width:100%;" />
      </div>
      <div class="form-field">
        <label>Term <b id="s-term-out" style="color:var(--accent-strong);">24 months</b></label>
        <input id="s-term" type="range" min="3" max="60" step="1" value="24" style="width:100%;" />
      </div>
    </div>
    <p class="calc-rate">Rate: <b id="out-rate2" style="color:var(--ink);">from 1.5%</b> per 30 days, repayable monthly</p>
  </div>

  <div class="stat-out-grid">
    <div class="stat-out">
      <span id="out-label1">Monthly interest</span>
      <b id="out-monthly">—</b>
      <small id="out-cap1"></small>
    </div>
    <div class="stat-out">
      <span id="out-label2">Arrangement fee</span>
      <b id="out-fee">—</b>
      <small id="out-cap2">2% added to the facility</small>
    </div>
    <div class="stat-out">
      <span id="out-label3">Total cost</span>
      <b id="out-total">—</b>
      <small id="out-cap3"></small>
    </div>
  </div>
  <p class="note" style="margin-bottom:0;">Indicative only — exact pricing is confirmed only after credit approval.</p>
</div>

<style>
  .calc-head h2 {
    margin: 0 0 0.2rem;
    font-size: 1.5rem;
  }

  .calc-head p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 44ch;
  }

  .calc-rate {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0.4rem 0 1.1rem;
  }

  .stat-out-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0.2rem 0 1rem;
  }

  .stat-out {
    padding: 0.9rem 1rem;
    background: var(--bg);
  }

  .stat-out + .stat-out {
    border-left: 1px solid var(--border);
  }

  .stat-out span {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }

  .stat-out b {
    display: block;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0.2rem 0 0.15rem;
    font-variant-numeric: tabular-nums;
  }

  .stat-out small {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.35;
    display: block;
  }

  .calc b.pop {
    animation: calcPop 0.3s ease;
  }

  @keyframes calcPop {
    0% {
      transform: scale(0.96);
      color: var(--accent-strong);
    }
    100% {
      transform: scale(1);
    }
  }

  #shop-calc input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--accent) var(--fill, 50%), var(--border) var(--fill, 50%));
    outline: none;
    cursor: pointer;
  }

  #shop-calc input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--accent-strong);
    box-shadow: 0 1px 4px rgba(17, 17, 17, 0.25);
    transition: transform 0.12s ease;
  }

  #shop-calc input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.12);
  }

  #shop-calc input[type="range"]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--accent-strong);
    box-shadow: 0 1px 4px rgba(17, 17, 17, 0.25);
  }

  #shop-calc input[type="range"]:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .stat-out-grid {
      grid-template-columns: 1fr;
    }

    .stat-out + .stat-out {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>

<script>
  const money = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', maximumFractionDigits: 0 });

  function rateForLtv(l) {
    if (l <= 55) return 0.64;
    if (l <= 65) return 0.69;
    return 0.74;
  }

  function bandForLtv(l) {
    if (l <= 55) return '· first charge under 55% LTV';
    if (l <= 65) return '· first charge 55–65% LTV';
    return '· first charge over 65% LTV';
  }

  const el = (id) => document.querySelector(`#shop-calc #${id}`);

  const moneyTag = (n) => money.format(n);

  function setOut(id, txt) {
    const node = el(id);
    node.classList.remove('pop');
    node.textContent = txt;
    void node.offsetWidth;
    node.classList.add('pop');
  }

  function fillTrack(id) {
    const input = el(id);
    if (!input) return;
    const pct = ((input.value - input.min) / (input.max - input.min)) * 100;
    input.style.setProperty('--fill', pct + '%');
  }

  function calc() {
    const mode = document.querySelector('#shop-calc .tab.active').dataset.mode;
    if (mode === 'bridging') {
      const amount = Number(el('b-amount').value);
      const ltv = Number(el('b-ltv').value);
      const term = Number(el('b-term').value);
      const rate = rateForLtv(ltv);
      const monthly = (amount * rate) / 100;
      const fee = amount * 0.02;
      const totalInterest = monthly * term;
      el('b-amount-out').textContent = moneyTag(amount);
      el('b-ltv-out').textContent = ltv + '%';
      el('b-term-out').textContent = term + (term === 1 ? ' month' : ' months');
      el('out-rate').textContent = rate.toFixed(2) + '%';
      el('out-band').textContent = bandForLtv(ltv);
      setOut('out-monthly', moneyTag(monthly));
      setOut('out-fee', moneyTag(fee));
      setOut('out-total', moneyTag(fee + totalInterest));
      el('out-label1').textContent = 'Monthly interest';
      el('out-label2').textContent = 'Arrangement fee';
      el('out-label3').textContent = 'Total cost';
      el('out-cap1').textContent = `interest only · ${term} months`;
      el('out-cap2').textContent = '2% added to the facility';
      el('out-cap3').textContent = `fee + ${term} months of interest`;
      fillTrack('b-amount');
      fillTrack('b-ltv');
      fillTrack('b-term');
    } else {
      const amount = Number(el('s-amount').value);
      const term = Number(el('s-term').value);
      const r = 0.015;
      const monthly = (amount * r) / (1 - Math.pow(1 + r, -term));
      const total = monthly * term;
      el('s-amount-out').textContent = moneyTag(amount);
      el('s-term-out').textContent = term + ' months';
      el('out-rate2').textContent = 'from 1.5%';
      setOut('out-monthly', moneyTag(monthly));
      setOut('out-fee', moneyTag(total - amount));
      setOut('out-total', moneyTag(total));
      el('out-label1').textContent = 'Monthly payment';
      el('out-label2').textContent = 'Total interest';
      el('out-label3').textContent = 'Total repayable';
      el('out-cap1').textContent = `principal + interest · ${term} months`;
      el('out-cap2').textContent = 'at 1.5% per 30 days';
      el('out-cap3').textContent = `over ${term} fixed payments`;
      fillTrack('s-amount');
      fillTrack('s-term');
    }
  }

  document.querySelectorAll('#shop-calc .tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#shop-calc .tab').forEach((b) => b.classList.toggle('active', b === btn));
      document.querySelectorAll('#shop-calc [data-fields]').forEach((f) => (f.hidden = f.dataset.fields !== btn.dataset.mode));
      calc();
    });
  });

  ['b-amount', 'b-ltv', 'b-term', 's-amount', 's-term'].forEach((id) => {
    el(id).addEventListener('input', calc);
    fillTrack(id);
  });

  calc();
</script>