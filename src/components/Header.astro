---
import { BRAND } from '../data/client-site.mjs';

const path = Astro.url.pathname;
const active = (href) =>
  path === href || (href !== '/' && path.startsWith(href)) ? { 'aria-current': 'page' } : {};
---

<div class="strip">
  Business lending carries risk. Investments can lose value and are not protected by the FSCS.
  <a href="/legal/">Risk summary</a>
</div>

<header class="top band">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Home">
      <svg width="46" height="38" viewBox="0 0 46 40" aria-hidden="true">
        <circle cx="9" cy="29" r="7.5" fill="var(--lemon)" stroke="currentColor" stroke-width="3" />
        <circle cx="23" cy="20" r="9" fill="var(--coral)" stroke="currentColor" stroke-width="3" />
        <circle cx="37" cy="10" r="7.5" fill="var(--blue)" stroke="currentColor" stroke-width="3" />
      </svg>
      <span>{BRAND}</span>
    </a>
    <button class="menu" id="menuBtn" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav class="nav" id="nav" aria-label="Main">
      <a href="/products/" {...active('/products/')}>Borrow</a>
      <a href="/rates/" {...active('/rates/')}>Rates</a>
      <a href="/invest/" {...active('/invest/')}>Invest</a>
      <a href="/learn/" {...active('/learn/')}>Learn</a>
      <a href="/about/" {...active('/about/')}>Company</a>
      <a class="btn" href="/apply/">Apply</a>
    </nav>
  </div>
</header>
