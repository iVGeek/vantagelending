---
import { site } from '../data/site.mjs';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-about">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="30" height="30" role="img">
              <rect x="1" y="1" width="30" height="30" rx="8" fill="var(--ink)" />
              <text x="16" y="21" text-anchor="middle" font-size="15" font-weight="800" fill="var(--accent)" font-family="inherit">S</text>
              <rect x="9" y="25" width="14" height="3" rx="1.5" fill="var(--accent)" />
            </svg>
          </span>
          <span class="brand-name">SME Lending <em>Platform</em></span>
        </div>
        <p class="brand-tag">{site.tagline}</p>
        <p class="disclosure" style="max-width:46ch;">{site.footerNote}</p>
      </div>
      <div class="footer-cols">
        <div>
          <h4>Borrow</h4>
          <ul>
            <li><a href="/products/">All products</a></li>
            <li><a href="/products/unsecured-business-loans/">Unsecured business loans</a></li>
            <li><a href="/products/residential-bridging/">Residential bridging</a></li>
            <li><a href="/products/commercial-bridging/">Commercial bridging</a></li>
            <li><a href="/rates/">Rates</a></li>
            <li><a href="/compare/">Compare</a></li>
            <li><a href="/apply/">Apply</a></li>
          </ul>
        </div>
        <div>
          <h4>Invest</h4>
          <ul>
            <li><a href="/invest/">Invest overview</a></li>
            <li><a href="/invest/how-it-works/">How it works</a></li>
            <li><a href="/invest/deals/">Live deals</a></li>
            <li><a href="/invest/calculator/">Return calculator</a></li>
            <li><a href="/invest/eligibility/">Eligibility</a></li>
            <li><a href="/invest/institutional/">Institutional &amp; family office</a></li>
            <li><a href="/invest/register/">Register interest</a></li>
          </ul>
        </div>
        <div>
          <h4>Learn</h4>
          <ul>
            <li><a href="/learn/">All guides</a></li>
            <li><a href="/learn/glossary/">Glossary</a></li>
            <li><a href="/case-studies/">Case studies</a></li>
            <li><a href="/eligibility/">Eligibility &amp; exclusions</a></li>
            <li><a href="/documents/">Document checklist</a></li>
            <li><a href="/faqs/">FAQs</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/legal/">Legal &amp; compliance</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{site.phone}</span>
      <span>{site.email}</span>
      <span>{site.address}</span>
      <span>{site.companyNo}</span>
      <span>{site.ico}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--navy);
    color: #dfe8ef;
    margin-top: 4rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.35fr 2fr;
    gap: 2.5rem;
    padding: 3rem 0 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 800;
    font-size: 1.06rem;
    color: #fff;
  }

  .brand-name em {
    font-style: normal;
    color: var(--accent);
  }

  .brand-mark {
    display: inline-flex;
    line-height: 0;
  }

  .brand-mark svg {
    display: block;
  }

  .brand-tag {
    color: #9fb3c2;
    font-size: 0.98rem;
    margin: 1rem 0 0.4rem;
    max-width: 34ch;
  }

  .site-footer .disclosure {
    color: #8fa3b4;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 1.5rem;
  }

  .footer-cols h4 {
    margin: 0 0 0.7rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .footer-cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-cols a {
    display: inline-block;
    padding: 0.24rem 0;
    text-decoration: none;
    color: #cfdbe5;
    font-size: 0.92rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .footer-cols a:hover {
    color: #fff;
    transform: translateX(2px);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.2rem 0;
    color: #8fa3b4;
    font-size: 0.82rem;
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
    }

    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-cols {
      grid-template-columns: 1fr;
    }
  }
</style>